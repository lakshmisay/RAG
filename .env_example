# Required for retrieval because the FAISS index uses OpenAI embeddings.
OPENAI_API_KEY=""

# Optional: use Groq for the chat/answer model.
GROQ_API_KEY=""

# Optional defaults shown in the Streamlit sidebar.
OPENAI_CHAT_MODEL="gpt-4o-mini"
# Leave blank to auto-select the first model returned by your Groq account.
GROQ_CHAT_MODEL=""
